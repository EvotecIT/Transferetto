<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">
      netstandard2.0;net472;net8.0
    </TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`OSX`))' Or '$([MSBuild]::IsOsPlatform(`Linux`))' ">
      netstandard2.0;net8.0
    </TargetFrameworks>
    <AssemblyName>Transferetto</AssemblyName>
    <Title>Transferetto</Title>
    <Description>Umbrella package for the Transferetto core engine and supported transfer providers.</Description>
    <VersionPrefix>2.0.1</VersionPrefix>
    <AssemblyVersion>2.0.1</AssemblyVersion>
    <FileVersion>2.0.1</FileVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>Transferetto</PackageId>
    <PackageProjectUrl>https://github.com/EvotecIT/Transferetto</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>transfer;ftp;ftps;sftp;scp;ssh;s3;azure;blob;storage</PackageTags>
    <RepositoryUrl>https://github.com/EvotecIT/Transferetto</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transferetto.Core\Transferetto.Core.csproj" />
    <ProjectReference Include="..\Transferetto.Protocols\Transferetto.Protocols.csproj" />
    <ProjectReference Include="..\Transferetto.S3\Transferetto.S3.csproj" />
    <ProjectReference Include="..\Transferetto.AzureBlob\Transferetto.AzureBlob.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
